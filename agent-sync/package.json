{
  "name": "farmaflow-sync-agent",
  "version": "1.0.0",
  "description": "Agente de sincronização modular para FarmaFlow AI",
  "scripts": {
    "start:siagold": "node src/entry-siagold.js",
    "start:softpharma": "node src/entry-softpharma.js",
    "build:siagold": "pkg src/entry-siagold.js -t node18-win-x64 -o build/farmaflow-siagold.exe",
    "build:softpharma": "pkg src/entry-softpharma.js -t node18-win-x64 -o build/farmaflow-softpharma.exe",
    "build:all": "npm run build:siagold && npm run build:softpharma",
    "build-and-zip": "node build-and-zip.js"
  },
  "dependencies": {
    "archiver": "^8.0.0",
    "axios": "^1.6.0",
    "mssql": "^10.0.1"
  },
  "devDependencies": {
    "pkg": "^5.8.1"
  }
}
