{
  "functions": {
    "api/**/*": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/(index.html|sw.js)?",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*([wW]hats[aA]pp|[fF]acebookexternalhit|[fF]acebot|[tT]witterbot|[tT]elegram[bB]ot|[lL]inkedin[bB]ot|[sS]lackbot|[dD]iscordbot).*"
        }
      ],
      "destination": "/api/og-handler",
      "permanent": false
    },
    {
      "source": "/loja/(.*)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*([wW]hats[aA]pp|[fF]acebookexternalhit|[fF]acebot|[tT]witterbot|[tT]elegram[bB]ot|[lL]inkedin[bB]ot|[sS]lackbot|[dD]iscordbot).*"
        }
      ],
      "destination": "/api/og-handler",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/og-handler",
      "destination": "/api/og-handler"
    },
    {
      "source": "/api/og",
      "destination": "/api/og-handler"
    },
    {
      "source": "/api/v1/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
